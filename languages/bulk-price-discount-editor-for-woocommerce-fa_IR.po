#, php-format
msgid "🗓️ Scheduled: %1$d products will be updated on %2$s."
msgstr "🗓️ زمان‌بندی شد: %1$d محصول در %2$s به‌روزرسانی می‌شود."

#. translators: %s: date and time the original prices are restored
#: admin/class-admin-assets.php:85
#, php-format
msgid "Original prices will be restored on %s."
msgstr "قیمت‌های اصلی در %s بازگردانده می‌شود."

